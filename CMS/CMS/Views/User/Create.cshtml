@model CME.Models.UserViewModel

@{
    ViewBag.Title = "Create User";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<h2 class="section-ttl" style="padding-top:20px;">Create User</h2>

<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddRole").change(function () {
            if ($("#ddRole option:selected").text() == "Admin") {
                $("#IsAdmin_True").prop("checked", true);
            }
            else { $("#IsAdmin_false").prop("checked", true); }
        });

      $("#ddZone").val('');
        $("#ddZone").change(function () {
            $("#ddMI").empty();
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetManagerByZone")',
                dataType: 'json',
                data: { id: $("#ddZone").val() },
                success: function (events) {
                    $.each(events, function (i, event) {
                        $("#ddMI").append('<option value="'
                            + event.Value + '">'
                            + event.Text + '</option>');
                    });
                },
                error: function (ex) {
                    alert('Failed to retrieve states.' + ex);
                }
            });
            return false;
        });
    });
</script>

