<script type="text/javascript">

     function submitPAFForm() {
         var app = $("#txtApproximatecost").val();
         var dd = $("#IsDateDeviation").val().toString();
         var pv = $("#Policy_Violation").val().toString();
         if (dd == "true" && pv == "true") { var CAPV = "contains Critical policy violation"; }
         else if (dd == "true" && pv == "false") { var CAPV = "contains Acceptable policy violation"; }
         else { var CAPV = "does not contains any violation"; }
         var data = ("Form total cost is " + app + " and " + CAPV + " . Are you sure you want send the form for approval ? ");

         if (confirm(data)) {
             return true;
         } else {
             return false;
         }
    }

    function validateHCPDetails() {
        if ($('#PtoHcp').val() === "" || $('#PtoHcp').val()) {
            $('.hhcpAmount').show();
            return false;
        }
        else {
            $('.hhcpAmount').hide();
        }
    }

    function setHCPType(t) {
        validateHCPDetails();
        $('#hcpType').val(t);
        return true;
    }

     $(document).ready(function () {

            $('.TabDisplay1').prop('disabled', true);
            $('.TabDisplay2').prop('disabled', true);
            $('.TabDisplay3').prop('disabled', true);
            if ('@TempData["TabDisplay"]' == 'Valid1') {
                $('.TabDisplay1').prop('disabled', false);
                $('.nav-tabs li:eq(1) a').tab('show');
              }
            else if ('@TempData["TabDisplay"]' == 'Valid2') {
                $('.TabDisplay1').prop('disabled', false);
                $('.TabDisplay2').prop('disabled', false);
                $('.nav-tabs li:eq(2) a').tab('show');
            }
            else if ('@TempData["TabDisplay"]' == 'Valid3') {
                $('.TabDisplay1').prop('disabled', false);
                $('.TabDisplay2').prop('disabled', false);
                $('.TabDisplay3').prop('disabled', false);
                $('.nav-tabs li:eq(3) a').tab('show');
                $(".btn_save").show();
                $(".btn_send").show();
                $(".btn_next").hide();
         }

       $("#Psearch").click(function () {
             var Name = $("#PSName").val();
             var City = $("#PSCity").val();
             var CustomerID = $("#PSCID").val();
             $.ajax({
                 url: '@Url.Action("SearchParticipants")',
                 contentType: 'application/html; charset=utf-8',
                 type: 'GET',
                 dataType: 'html',
                 data: { Name: Name, City: City, CustomerID: CustomerID },
                success: function (list) {
                    $('#Preview').html(list);
                    $('#Preview').show();
                     $('#exampleModal').modal('show');
                },
                error: function (ex) {
                    alert('Failed to retrieve states.' + ex);
                }
            })
       });

         $('#pclose').click(function () {
             $('input[type="text"]').val('');
             $('#Preview').hide();
         });

         $("#Icomments").keyup(function () {
             //alert($("#Icomments").val());
             $('#Invoice_Comment').html($("#Icomments").val());
         });

         $("#HQcomments").keyup(function () {
             $('#HQ_Comment').html($("#HQcomments").val());
         });

         $("#AMcomments").keyup(function () {
             $('#AM_Comment').html($("#AMcomments").val());
         });

         $("#HEcomments").keyup(function () {

             $('#HE_Comment').html($("#HEcomments").val());
         });

         $("#btnNext").click(function () {

             var data = $('ul#apptabs li a.active').parent().attr('id');

                if (data == 'PD') {
                    $(this).val('DetailsNext');
                }
                else if (data == 'PHCP') {
                    $(this).val('HCPNext');
                }
                else if (data == 'PC') {
                    $(this).val('CostNext');
                }
                else {
                    $(this).val('DetailsNext');
                }
            });




        $("#divAssessmentPartialView").hide();
        $("#PVDate").hide();
        $("#CPVDate").hide();
        $("#tr_aRemoveFileMA").hide();
        $("#tr_aRemoveFileHQ").hide();
        $("#tr_fileListLM").hide();
        $("#tr_HotelException").hide();
        $("#aRemoveFileMA").hide();
        $("#aRemoveFileHQ").hide();
        $("#HotelException").hide();
        $("#fileAttachments").hide();
        $(".Htopicmandatory").hide();
