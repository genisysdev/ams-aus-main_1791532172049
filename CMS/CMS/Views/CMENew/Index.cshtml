@model CME.Models.CMEViewModel
@{
    ViewBag.Title = "New PAF Activity";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
<script src="~/Scripts/jquery-1.12.4.js"></script>
<script src="~/Scripts/jquery-1.12.4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-fQybjgWLrvvRgtW6bFlB7jaZrFsaBXjsOMm/tB9LTS58ONXgqbR9W8oWht/amnpF" crossorigin="anonymous"></script>
<script src='@System.Web.Optimization.Scripts.Url("~/bundles/jqueryui")'></script>
<script src='@System.Web.Optimization.Scripts.Url("~/bundles/validatemin")'></script>



@using (Html.BeginForm("Index", "CMENew", FormMethod.Post, new { role = "form", id = "prospects_form", enctype = "multipart/form-data" }))
{
    <div>
        <p style="font-size:28px"><b>New PAF Activity</b></p>
        <br>
        <!-- Nav tabs -->
        <div class="row align-items-center">
            <div class="col-md-6 mb-2">
                <div class="tabs">
                    <ul id="apptabs" class="nav nav-tabs" role="tablist">
                        <li id="PD" class="nav-item">
                            <a class="nav-link active navlink" data-toggle="tab" href="#Nav1">PAF Details</a>
                        </li>
                        <li id="PHCP" class="nav-item">
                            <a class="nav-link navlink TabDisplay1" data-toggle="tab" href="#Nav2">HCP Details</a>
                        </li>
                        <li id="PC" class="nav-item">
                            <a class="nav-link navlink TabDisplay2" data-toggle="tab" href="#Nav3">Cost Details</a>
                        </li>
                        <li id="PA" class="nav-item">
                            <a class="nav-link navlink TabDisplay3" data-toggle="tab" href="#Nav4">Attachment</a>
                        </li>
                    </ul>
                </div>
            </div>
            <div class="col-md-6">
                <div class="btn_save" style="display:none;">
                    <button type="submit" id="btnSave" class="btn add-btn" name="command" value="Draft" style="float:right;" onclick="return submitPAFForm();">Save</button>
                </div>
                <div class="btn_send " style=" display:none;">
                    <button type="submit" id="btnSend" class="btn add-btn ml-2 mr-2" name="command" value="Send" style="float:right;" onclick="return submitPAFForm();">Send Form</button>
                </div>
                <div class="btn_next">
                    <button type="submit" id="btnNext" class="btn add-btn" name="command" value="" style="float:right;">Next</button>
                </div>
            </div>

        </div>


        <div class="tab-content contentcolor">
            <div id="Nav1" class="container tab-pane active">
                @Html.HiddenFor(model => model.IsDateDeviation)
                @Html.HiddenFor(model => model.Policy_Violation)
                @Html.HiddenFor(model => model.IsVirtual)
                <div class="form-group" id="CPVDate" style="display:none;">
                    <label style="color:red;font-size:17px; padding-left: 350px;"><b>Critical policy violation</b></label>
                </div>
                <div class="form-group" id="PVDate" style="display:none;">
                    <label style="color:#d11313;font-size:17px; padding-left: 350px;"><b>Acceptable policy violation</b></label>
                </div>
                <div>
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Issued By </label>
                                <div class="Input_span">
                                    <span>@Session["LoginUserInitial"].ToString()</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Issued Date </label>
                                <div class="Input_span">
                                    <span>@DateTime.Now.Date.Day-@DateTime.Now.Month-@DateTime.Now.Year</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Form ID </label>
                                <div class="Input_span">
                                    <span>@Session["PAFChar"]@Session["newPAFId"]</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Approver(s) </label>
                                <div class="Input_span">
                                    <span>@Html.DisplayFor(model => model.Approver)</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2 Radioandcheck">
                            <label>
                                @Html.CheckBoxFor(m => m.HospitalMeeting, new { id = "cbHM" })<br />
                                Hospital Meeting
                            </label>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-8 mb-2">
                            <label class="label_span_Checkbox">Form Type <span class="mandatory-field">*</span></label><br />
                            <div class="Input_span_Checkbox">
                                @Html.RadioButtonFor(model => model.CME_Type, "Standard Meeting", new { @class = "form-radio", @checked = "checked", id = "rbSM" })
                                Standard Meeting
                                <span style="padding-left:180px"></span>
                                @Html.RadioButtonFor(model => model.CME_Type, "Non-Standard Meeting", new { @class = "form-radio", id = "rbNSM" })
                                Non-Standard Meeting
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div id="divdiseasearea" style="display:none;">
                                <label class="label_span_Checkbox">Disease Area <span class="mandatory-field">*</span></label>
                                <div class="Input_span_Checkbox">
                                    @Html.RadioButtonFor(model => model.DiseaseArea_Type, "Hemophilia Medical", new { @class = "form-radio", @checked = "checked", id = "rbHM" })
                                    <span for="Hemophilia">Hemophilia</span>
                                    @Html.RadioButtonFor(model => model.DiseaseArea_Type, "Growth Hormone Medical", new { @class = "form-radio", id = "rbGHM" })
                                    <span for="GrowthHormone">Growth Hormone</span><br>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative" id="divTheraphy">
                                <div id="NonstdT">
                                    <label>Therapy Area</label>
                                    <div class="Input_span">
                                        <span style="color: #3a3a3a;font-weight: bold;text-transform: uppercase;">
                                            @Html.DisplayFor(model => model.TherapyAreaName)
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="form-controls position-relative" id="stdT">
                                <label>Therapy Area <span class="mandatory-field">*</span></label>
                                @Html.DropDownListFor(model => model.SelectedTherapyArea, Model.TherapyArea, "- Please select a TherapyArea -", new { @class = "form-control", @tabindex = 1, id = "ddTherapyArea" })
                                @Html.ValidationMessageFor(model => model.SelectedTherapyArea, "", new { @class = "text-danger" })
                                <span class="text-danger">@TempData["sTherapyArea"]</span>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2" id="divBrand">
                            <div class="form-controls position-relative">
                                <label>Brand <span class="mandatory-field">*</span></label>
                                @Html.DropDownListFor(model => model.SelectedBrand, Model.Brand, "- Please select a Brand -", new { @class = "form-control", id = "ddBrand", })
                                @Html.ValidationMessageFor(model => model.SelectedBrand, "", new { @class = "text-danger" })
                                <span class="text-danger">@TempData["sBrandArea"]</span>
                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <div id="divActivityName" style="display:none;">
                                    <label>Activity Name <span class="mandatory-field">*</span></label>
                                    @Html.TextBoxFor(m => m.ActivityName, new { @class = "form-control", maxlength = 250, @tabindex = 3, id = "txtActivityName" })
                                    @Html.ValidationMessageFor(model => model.ActivityName, "", new { @class = "text-danger" })
                                </div>
                                <div id="divEventList">
                                    <label id="lblEvent">Event <span class="mandatory-field">*</span></label>
                                    @Html.DropDownListFor(model => model.SelectedEvent, Model.Event, "- Please select a Event -", new { @class = "form-control", id = "ddEvent" })
                                    @Html.ValidationMessageFor(model => model.SelectedEvent, "", new { @class = "text-danger" })
                                    <span class="text-danger">@TempData["sEventArea"]</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2" id="divLecture">
                            <div class="form-controls position-relative">

                                <label>Lecture <span class="mandatory-field">*</span></label>
                                @Html.DropDownListFor(model => model.SelectedLecture, Model.Lectures, "- Please select a Lecture -", new { @class = "form-control", id = "ddLecture" })
                                @Html.ValidationMessageFor(model => model.SelectedLecture, "", new { @class = "text-danger" })
                                <span class="text-danger">@TempData["sLecture"]</span>
                                <div id="divPartialView">
                                    @{Html.RenderPartial("~/Views/CME/_Materials.cshtml");}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Activity Start Date <span class="mandatory-field">*</span></label>
                                @Html.EditorFor(model => model.ActivityStartDate, new { htmlAttributes = new { @class = "form-control date-field", @tabindex = 4, @readonly = "true", id = "startDate" } })
                                @Html.ValidationMessageFor(model => model.ActivityStartDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Activity End Date <span class="mandatory-field">*</span></label>
                                @Html.EditorFor(model => model.ActivityEndDate, new { htmlAttributes = new { @class = "form-control date-field", @tabindex = 5, @readonly = "true", id = "endDate" } })
                                @Html.ValidationMessageFor(model => model.ActivityEndDate, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Number of Days <span class="mandatory-field">*</span></label>
                                @Html.TextBoxFor(m => m.NumberofDays, new { @class = "form-control", @readonly = "readonly", @type = "number", id = "noDays", @tabindex = 6 })
                                @Html.ValidationMessageFor(model => model.NumberofDays, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Proposed number of attendee(s) <span class="mandatory-field">*</span></label>
                                @Html.TextBoxFor(m => m.Proposednumberofattendee, new { @class = "form-control", @type = "number", @tabindex = 7, id = "Proposednumberofattendee" })
                                @Html.ValidationMessageFor(model => model.Proposednumberofattendee, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Minimum number of guarantee <span class="mandatory-field">*</span></label>
                                @Html.TextBoxFor(m => m.Minimumnumberofgaurantee, new { @class = "form-control", @type = "number", @tabindex = 8 })
                                @Html.ValidationMessageFor(model => model.Minimumnumberofgaurantee, "", new { @class = "text-danger" })
                                <span class="text-danger">@TempData["Minnuofgu"]</span>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>City <span class="mandatory-field">*</span></label>
                                @Html.TextBoxFor(m => m.City, new { @class = "form-control", @tabindex = 13, maxlength = 50 })
                                @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-12 mb-2 ">
                            <div class="row align-items-center">
                                <div class="col-md-12 mb-0">
                                    <label style="float:left;">
                                        @Html.CheckBoxFor(m => m.Hotel_Star, new { @tabindex = 15, id = "ckbHotelStar" }) 5 Star Hotel?
                                        @Html.ValidationMessageFor(x => x.Hotel_Star)
                                    </label>
                                </div>
                            </div>
                            <div class="form-controls position-relative">
                                <label>Venue/Hotel <span class="mandatory-field">*</span></label>
                                @Html.TextAreaFor(m => m.Venu_Hotel, new { @class = "form-control textarea", @tabindex = 14 })
                                @Html.ValidationMessageFor(model => model.Venu_Hotel, "", new { @class = "text-danger" })

                            </div>
                        </div>
                    </div>
                    <div class="row align-items-center">
                        <div class="col-md-4 mb-2">
                            <div class="form-controls position-relative">
                                <label>Meeting type <span class="mandatory-field">*</span></label>
                                @Html.DropDownListFor(model => model.SelectedMeetingType, Model.MeetingType, "- Please select a MeetingType -", new { @class = "form-control", @tabindex = 1, id = "ddMeetingType" })
                                @Html.ValidationMessageFor(model => model.SelectedMeetingType, "", new { @class = "text-danger" })
                                <span class="text-danger">@TempData["sMeetingType"]</span>
                            </div>
                        </div>
                        <div class="col-md-4 mb-2">

                            <label>BTC Status <span class="mandatory-field">*</span></label>
                            <div>
                                @Html.RadioButtonFor(model => model.IsBTC, "false", new { @class = "form-radio", id = "isBTC" })
                                <span style="color:#0a78bf; font-weight: bold;margin-right:10px;">No</span>
                                @Html.RadioButtonFor(model => model.IsBTC, "true", new { @class = "form-radio", id = "isNotBTC" })
                                <span style="color:#0a78bf; font-weight: bold;">Yes</span>
                            </div>
                            @Html.ValidationMessageFor(model => model.IsBTC, "", new { @class = "text-danger" })
                            <span class="text-danger">@TempData["sBTC"]</span>
                        </div>
                    </div>
                    <div class="row align-items-center">

                        <div class="col-md-12 mb-2 ">
                            <div class="form-controls position-relative">
                                <label>Comments <span class="mandatory-field">*</span></label>
                                @Html.TextAreaFor(m => m.Comment, new { @class = "form-control textarea", @tabindex = 14 })
                                @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="Nav2" class="container tab-pane fade">
                <div>
                    <ul class="nav nav-tabs navlinksubTag" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active navlinksub" data-toggle="tab" href="#Hon">Honorarium</a>

                        </li>
                        <li class="nav-item">
                            <a class="nav-link navlinksub" data-toggle="tab" href="#NHon">Non Honorarium</a>
                        </li>
                    </ul>
                    <div class="tab-content">
                        <div id="Hon" class="container tab-pane fade active show">
                            <div class="row align-items-center">
                                <div class="col-md-4 mb-2">
                                    <div class="form-controls position-relative">
                                        <label>HCP Role <span class="mandatory-field">*</span></label>
                                        @Html.DropDownListFor(model => model.SelectedTypeofHCP, Model.TypeofHCP, "- Please select a HCP Type -", new { @class = "form-control", id = "HCPTypeH" })
                                        @Html.ValidationMessageFor(model => model.SelectedTypeofHCP, "", new { @class = "text-danger" })
                                        <span class="text-danger hcpRole">@TempData["eHCPType"]</span>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <div class="form-controls position-relative">
                                        <label>HCP <span class="mandatory-field">*</span></label>
                                        @Html.DropDownListFor(model => model.SelectedNameoftheHCP, Model.NameoftheHCP, "- Please select a HCP Name -", new { @class = "form-control", id = "HCPNameH" })
                                        @Html.ValidationMessageFor(model => model.SelectedNameoftheHCP, "", new { @class = "text-danger" })
                                        <span class="text-danger hcpName">@TempData["eHCPName"]</span>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <div class="form-controls position-relative">
                                        <label>Honorarium payable to HCP (Amount in Rupees)<span class="mandatory-field">*</span></label>
                                        @Html.TextBoxFor(m => m.HCPCost, new { @class = "form-control", @type = "number", id = "PtoHcp" })
                                        <span class="text-danger hhcpAmount">* Please Select Honorarium payable to HCP</span>
                                        <span class="text-danger hcpAmount">@TempData["eHCPNCost"]</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <div class="col-md-4 mb-2">
                                    <div class="form-controls position-relative">
                                        <label>HCP topic <span class="mandatory-field Htopicmandatory">*</span></label>
                                        @Html.TextBoxFor(m => m.HCPtopic, new { @class = "form-control", id = "HcpTopicH" })
                                        <span class="text-danger hhcptoplic">* Please Enter the HCP topic</span>
                                    </div>
                                </div>
                            </div>
                            <div class="row align-items-center">
                                <div class="col-md-4 mb-2">
                                    <button type="submit" onclick="return setHCPType('Hon');" class="btn add-btn" name="command" value="Add HCP" id="btnAddHcpH">Add HCP</button>
                                </div>
                            </div>
                        </div>
                        <div id="NHon" class="container tab-pane fade">
                            <div>
                                <div class="row align-items-center">
                                    <div class="col-md-4 mb-2">
                                        <div class="form-controls position-relative">
                                            <label>HCP Role <span class="mandatory-field">*</span></label>
                                            @Html.DropDownListFor(model => model.SelectedTypeofHCP, Model.TypeofHCP, "- Please select a HCP Type -", new { @class = "form-control", id = "HCPTypeNoH" })
                                            @Html.ValidationMessageFor(model => model.SelectedTypeofHCP, "", new { @class = "text-danger" })
                                            <span class="text-danger">@TempData["eHCPNType"]</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <div class="form-controls position-relative">
                                            <label>TMF Number</label>
                                            @Html.TextBoxFor(m => m.TMFNo, new { @class = "form-control", id = "TmfNo" })
                                            @Html.ValidationMessageFor(x => x.TMFNo, "", new { @class = "text-danger" })
                                            <span class="text-danger">@TempData["eHCPNTmf"]</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <div class="form-controls position-relative">
                                            <label>First Name of the HCP <span class="mandatory-field">*</span></label>
                                            @Html.TextBoxFor(m => m.HCPFirstName, new { @class = "form-control", id = "HcpFNameNoH" })
                                            @Html.ValidationMessageFor(x => x.HCPFirstName, "", new { @class = "text-danger" })
                                            <span class="text-danger">@TempData["eHCPLNName"]</span>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <div class="form-controls position-relative">
                                            <label>Last Name of the HCP <span class="mandatory-field">*</span></label>
                                            @Html.TextBoxFor(m => m.HCPLastName, new { @class = "form-control", id = "HcpLNameNoH" })
                                            @Html.ValidationMessageFor(x => x.HCPLastName, "", new { @class = "text-danger" })
                                            <span class="text-danger">@TempData["eHCPLNName"]</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center">
                                    <div class="col-md-4 mb-2">
                                        <div class="form-controls position-relative NHForm">
                                            <div class="">
                                                <label class="m-0 NHlabel">Terms of Engagement/Pre-approved Invitation mail<span class="mandatory-field">*</span></label>
                                            </div>
                                            <div>
                                                @Html.TextBoxFor(m => m.NOHImageFile, new { type = "file", id = "file5", multiple = "multiple", onchange = "javascript:updateListHCP()" })
                                                <label for="file5" class="btn upload-btn m-0">Choose file</label>
                                                @if (@Model.NOHImageFile == null)
                                                {
                                                    <br />
                                                    @Html.ValidationMessageFor(model => model.NOHImageFile, "", new { @class = "text-danger" })
                                                }
                                                <span class="text-danger">@TempData["eHCPNfile"]</span>
                                            </div>

                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <div class="form-controls position-relative">
                                            <label>HCP topic <span class="mandatory-field NoHtopicmandatory">*</span></label>
                                            @Html.TextBoxFor(m => m.HCPtopicNoH, new { @class = "form-control", id = "HcpTopicNoH" })
                                            <span class="text-danger nonhcptoplic">* Please Enter the HCP topic</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center">
                                    <div class="col-md-4 mb-2">
                                        <div class="upload-item">
                                            <div id="fileListHCP"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row align-items-center">
                                    <div class="col-md-4 mb-2">
                                        <button type="submit" onclick="return setHCPType('NoHon');" class="btn add-btn" name="command" value="Add HCP" id="btnAddHcpNoH">Add HCP</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div><br><span class="text-danger">@TempData["eAddHCP"]</span></div>
                        <div><span class="text-danger">@TempData["eNolect"]</span></div>
                        <div><span class="text-danger">@TempData["SameUser"]</span></div>

                        @if (Model.HCPs != null && Model.HCPs.Count > 0)
                        {
                            <table class="table" id="tHCPNoH">
                                <tr>
                                    <th style="visibility:hidden">ID</th>
                                    <th>Name</th>
                                    <th>Address</th>
                                    <th>PAN</th>
                                    <th>Topic</th>
                                    <th>Cost</th>
                                    <th></th>
                                </tr>
                                @foreach (var item in Model.HCPs)
                                {
                                    <tr>
                                        <td style="visibility:hidden">@Html.DisplayFor(modelItem => item.Id)</td>
                                        <td id="hcpName">@Html.DisplayFor(modelItem => item.First_Name + item.Last_Name)</td>
                                        @if (item.HCPAddress != null)
                                        {
                                            <td id="Hcpaddress">@Html.DisplayFor(modelItem => item.HCPAddress)</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        @if (item.TMF_No != "0000000000")
                                        {
                                            <td>@Html.DisplayFor(modelItem => item.TMF_No)</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        <td>@Html.DisplayFor(modelItem => item.HCPtopic)</td>
                                        @if (item.Cost != 0)
                                        {
                                            <td id="Hcpcost" class="hcp-cost-to-add" style="text-align:right;">@Html.DisplayFor(modelItem => item.Cost)</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        <td>
