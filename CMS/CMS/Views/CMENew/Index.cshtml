            else {
                $('#IsVirtual').val(false);
                $('.HQmandatory').show();
                $(".spanbtc").show();
                $('#isBTC').attr("disabled", false);
                $('#isNotBTC').attr("disabled", false);
            }
        });



        $("#btnParticipants").click(function () {
               var values = new Array();
                $.each($("input[type=checkbox]:checked"), function () {
                    var data = $(this).parents('tr:eq(0)');
                    values.push({ 'ID': $(data).find('td:eq(0)').text(), 'Name': $(data).find('td:eq(2)').text(), 'PAN': $(data).find('td:eq(3)').text(), 'Email_Id': $(data).find('td:eq(4)').text(), 'Phone_Number': $(data).find('td:eq(5)').text(), 'Customer_ID': $(data).find('td:eq(6)').text() });
                });


            $("#jsonParticipantsdata").val(JSON.stringify(values));
        });

         $("#file1").on('change',function () {
             var value = $("#file1").val();
             if (value == "") {
                // alert(value);
                 $("#Ifile_error").show();
             } else {
                 $("#Ifile_error").hide();
             }
         });

         $("#file2").on('change', function () {
             var value = $("#file2").val();
             if (value == "") {
                 //alert(value);
                 $("#HQfile_error").show();
             } else {
                 $("#HQfile_error").hide();
             }
         });

         $("#file4").on('change', function () {
             var value = $("#file4").val();
             if (value == "") {
                // alert(value);
                 $("#HEfile_error").show();
             } else {
                 $("#HEfile_error").hide();
             }
         });

    });

    $(document).on('input', '.add-approxcost', function () {
        addapprox();
    });
    function addapprox() {
        var calculated_total_sum = 0;
        $(".add-approxcost").each(function () {
            var get_textbox_value = $(this).val();
            if ($.isNumeric(get_textbox_value)) {
               // calculated_total_sum += parseFloat(get_textbox_value);
                calculated_total_sum += parseFloat(get_textbox_value) * $("#Proposednumberofattendee").val();
            }

        });
        $(".misc-cost-to-add").each(function () {
            var get_textbox_value = parseInt($(this).html());
            if ($.isNumeric(get_textbox_value)) {
                calculated_total_sum += parseFloat(get_textbox_value);
            }
        });
        $(".hcp-cost-to-add").each(function () {
            var get_textbox_value = parseInt($(this).html());
            if ($.isNumeric(get_textbox_value)) {
                calculated_total_sum += parseFloat(get_textbox_value);
            }
        });
        $("#txtApproximatecost").val(calculated_total_sum);
    }




</script>

