        $('#startDate').datepicker({
            dateFormat: "dd-mm-yy",
            changeMonth: true,
            changeYear: true,
            yearRange: "-10:+1",
            minDate: 0,
            //maxDate: '31-03-2023',
            onSelect: function () {
                var date1 = new Date($('#startDate').val().replace(/(\d{2})-(\d{2})-(\d{4})/, "$2/$1/$3"));
                var date2 = new Date($('#endDate').val().replace(/(\d{2})-(\d{2})-(\d{4})/, "$2/$1/$3"));
                var Difference_In_Time = date2.getTime() - date1.getTime();
                var Difference_In_Days = Difference_In_Time / (1000 * 3600 * 24);
                if (typeof Difference_In_Days === "undefined") { Difference_In_Days = -1; }
                $("#noDays").val(Difference_In_Days + 1);


                //////////

                var d = new Date();
                var Difference_In_Time = date1.getTime() - d.getTime();
                var Difference_In_Days = Difference_In_Time / (1000 * 3600 * 24);
                if (typeof Difference_In_Days === "undefined") { Difference_In_Days = -1; }
                var days = Difference_In_Days + 1

                var HM = $('#cbHM').is(":checked")
                var Hmindays= @Html.Raw(Json.Encode(Model.HMinDays));
                var Hmaxdays= @Html.Raw(Json.Encode(Model.HMaxDays));
                var Dmindays =@Html.Raw(Json.Encode(Model.DMinDays));
                var Dmaxdays= @Html.Raw(Json.Encode(Model.DMaxDays));

                if (HM == true) {
                    if (days <= Hmaxdays && days >= Hmindays) {
                        $("#CPVDate").hide();
                        $("#PVDate").show();
                        $("#IsDateDeviation").val(true);
                        $("#Policy_Violation").val(false);
                    }
                    else if (days <= Hmindays) {
                        $("#PVDate").hide();
                        $("#CPVDate").show();
                        $("#IsDateDeviation").val(true);
                        $("#Policy_Violation").val(true)
                    }
                    else {
                        $("#PVDate").hide();
                        $("#CPVDate").hide();
                        $("#IsDateDeviation").val(false);
                        $("#Policy_Violation").val(false)
                    }

                }
                else {
                    $("#HospitalMeeting").val(false);
                    if (days <= Dmaxdays && days >= Dmindays) {
                        $("#CPVDate").hide();
                        $("#PVDate").show();
                        $("#IsDateDeviation").val(true);
                        $("#Policy_Violation").val(false);
                    }
                    else if (days <= Dmindays) {
                        $("#PVDate").hide();
                        $("#CPVDate").show();
                        $("#IsDateDeviation").val(true);
                        $("#Policy_Violation").val(true)
                    }
                    else {
                        $("#PVDate").hide();
                        $("#CPVDate").hide();
                        $("#IsDateDeviation").val(false);
                        $("#Policy_Violation").val(false);
                    }
                }

            }
        });


