@model DataAccessLayer.DAL.Model.CMEDetails

@{
    ViewBag.Title = "Meeting Details";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
<script src="~/Scripts/jquery-1.12.4.js"></script>
<script src="~/Scripts/jquery-1.12.4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-fQybjgWLrvvRgtW6bFlB7jaZrFsaBXjsOMm/tB9LTS58ONXgqbR9W8oWht/amnpF" crossorigin="anonymous"></script>
<script src='@System.Web.Optimization.Scripts.Url("~/bundles/jqueryui")'></script>
<script src='@System.Web.Optimization.Scripts.Url("~/bundles/validatemin")'></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />

@using (Html.BeginForm("Details", "CMENew", FormMethod.Post, new { role = "form", enctype = "multipart/form-data" }))
{
    <div>
        <p style="font-size:28px"><b>Meeting Details</b></p>
        <br />
        <!-- Buttons -->
        <div class="row align-items-center">
            <div class="col-md-12 mb-2">
                <div style="float:right;">
                    <input type="hidden" value="@Model.HCPSJson" id="hcpsData" />
                    <fieldset class="submit" id="NotBiopharmbtn" style="display:none;">
                        @if (Model.RequestType == "Send" || Model.RequestType == "Send to RBD" || Model.RequestType == "Approved by SR" || Model.RequestType == "Approved by SM" || (Model.RequestType == "Approved by RBD" && Model.IsVirtual != true && Model.IsBTC == true) || Model.RequestType == "Send to cancel approve" || Model.RequestType == "Send to postpone")
                        {
                            <button type="submit" id="btnSave" class="btn add-btn" name="command" value="Approve" onclick="return SubmitApprove();">Approve</button>
                            <button type="submit" id="btnSend" class="btn add-btn" name="command" value="Reject" onclick="return SubmitReject();">Reject</button>
                        }
                        @if (Model.RequestType == "Send" || Model.RequestType == "Resend by CT" || Model.RequestType == "Send to RBD" || Model.RequestType == "Approved by SR" || Model.RequestType == "Approved by SM")
                        {
                            //cancelation by approver
                            <input type="button" id="btnRemovePAF" class="btn add-btn" name="command" value="Cancel Event" onclick="SubmitCancel();" />
                        }
                        @if ((Model.RequestType == "Approved by CME Operation") || (Model.RequestType == "Approved by RBD" && Model.IsVirtual == true) || (Model.RequestType == "Approved by RBD" && Model.IsBTC == false))
                        {
                            <button type="submit" id="btnSend" class="btn add-btn" name="command" value="Close">Close</button>
                            <input type="button" id="btnRemovePAF" class="btn add-btn" name="command" value="Cancel Event" onclick="SubmitCancel();" />
                            <button type="submit" id="btndownloadchln" class="btn add-btn" name="command" value="Challan" formaction=@Url.Action("Challan", new { id = Model.Form_ID }) formmethod="post">HCP Challan</button>
                        }
                        <button type="submit" id="btnPrint" class="btn add-btn" name="command" value="Print" formaction=@Url.Action("Print", new { id = Model.Form_ID }) formmethod="post">Print</button>
                        @if (Model.RequestType == "Approved by CME Operation" || (Model.RequestType == "Approved by RBD" && Model.IsVirtual == true) || (Model.RequestType == "Approved by RBD" && Model.IsBTC == false))
                        {
                            <input type="button" id="btnPostpone" class="btn add-btn" name="command" value="Postpone" onclick="location.href='@Url.Action("Postpone", new { id = Model.Form_ID })'" />
                        }
                        <button type="submit" id="btndownloadall" class="btn add-btn" name="command" value="Downloadall" formaction=@Url.Action("DownloadAll", new { id = Model.Form_ID }) formmethod="post">Download All Documents</button>
                        <button type="submit" id="btnCancel" class="btn add-btn" name="command" value="Cancel">Back</button>
                    </fieldset>
                    <fieldset class="submit" id="Biopharmbtn" style="display:none;">
                        @if (Model.RequestType == "Send" || Model.RequestType == "Send to RBD" || Model.RequestType == "Approved by SM" || (Model.RequestType == "Approved by RBD1" && Model.TotalCost > 150000 && (Session["LoginUserRole"].ToString().ToUpper() != "KAM" || Session["LoginUserRole"].ToString().ToUpper() != "CT" || Session["LoginUserRole"].ToString().ToUpper() != "SR" || Session["LoginUserRole"].ToString().ToUpper() != "SM" || Session["LoginUserRole"].ToString().ToUpper() != "CTB"))
|| Model.RequestType == "Approved by Hemophilia Medical" || Model.RequestType == "Approved by Growth Hormone Medical" || Model.RequestType == "Send to cancel approve" || Model.RequestType == "Send to postpone")
                        {
                            <button type="submit" id="btnSave" class="btn add-btn" name="command" value="Approve" onclick="return SubmitApprove();">Approve</button>
                            <button type="submit" id="btnReject" class="btn add-btn" name="command" value="Reject" onclick="return SubmitReject();">Reject</button>
                        }
                        @if (Model.RequestType == "Send" || Model.RequestType == "Send to RBD" || Model.RequestType == "Approved by SR" || Model.RequestType == "Approved by SM")
                        {
                            //cancelation by approver
                            <input type="button" id="btnRemovePAF" class="btn add-btn" name="command" value="Cancel Event" onclick="SubmitCancel();" />
                        }
                        @if ((Model.RequestType == "Approved by CME Operation") || (Model.RequestType == "Approved by RBD" && Model.IsVirtual == true) || (Model.RequestType == "Approved by RBD" && Model.IsBTC == false))
                        {
                            <button type="submit" id="btnSend" class="btn add-btn" name="command" value="Close">Close</button>
                            <input type="button" id="btnRemovePAF" class="btn add-btn" name="command" value="Cancel Event" onclick="SubmitCancel();" />
                            <button type="submit" id="btndownloadchln" class="btn add-btn" name="command" value="Challan" formaction=@Url.Action("Challan", new { id = Model.Form_ID }) formmethod="post">HCP Challan</button>
                        }
                        @if (Model.RequestType == "Approved by CME Operation" || (Model.RequestType == "Approved by RBD" && Model.IsVirtual == true) || Model.RequestType == "Resend by CT" || (Model.RequestType == "Approved by RBD" && Model.IsBTC == false))
                        {
                            <input type="button" id="btnPostpone" class="btn add-btn" name="command" value="Postpone" onclick="location.href='@Url.Action("Postpone", new { id = Model.Form_ID })'" />
                        }
                        <button type="submit" id="btnPrint" class="btn add-btn" name="command" value="Print" formaction=@Url.Action("Print", new { id = Model.Form_ID }) formmethod="post">Print</button>
                        <button type="submit" id="btndownloadall" class="btn add-btn" name="command" value="Downloadall" formaction=@Url.Action("DownloadAll", new { id = Model.Form_ID }) formmethod="post">Download All Documents</button>
                        <button type="submit" id="btnCancel" class="btn add-btn" name="command" value="Cancel">Back</button>
                    </fieldset>
                </div>
            </div>
        </div>

        <br>
        <!-- Nav tabs -->
        <div class="row align-items-center">
            <div class="col-md-12 mb-2">
                <div class="tabs">
                    <ul id="apptabs" class="nav nav-tabs" role="tablist">
                        <li id="PD" class="nav-item">
                            <a class="nav-link active navlink" data-toggle="tab" href="#Nav1">PAF Details</a>
                        </li>
                        <li id="PHCP" class="nav-item">
                            <a class="nav-link navlink TabDisplay1" data-toggle="tab" href="#Nav2">HCP List</a>
                        </li>
                        <li id="PC" class="nav-item">
                            <a class="nav-link navlink TabDisplay2" data-toggle="tab" href="#Nav3">Cost </a>
                        </li>
                        <li id="PA" class="nav-item">
                            <a class="nav-link navlink TabDisplay3" data-toggle="tab" href="#Nav4">PAF Approval Status & Comments</a>
                        </li>
                        <li id="PA" class="nav-item">
                            <a class="nav-link navlink TabDisplay3" data-toggle="tab" href="#Nav5">Attachments</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        @Html.HiddenFor(model => model.HCPs)
        <div class="tab-content contentcolor">
            <div id="Nav1" class="container tab-pane active">
                <div class="form-group" id="CPVDate">
                    <label style="color:red;font-size:17px; padding-left: 350px;"><b>Critical policy violation</b></label>
                </div>
                <div class="form-group" id="PVDate">
                    <label style="color:#d11313;font-size:17px; padding-left: 350px;"><b>Acceptable policy violation</b></label>
                </div>

                @if ((Session["LoginUserRole"].ToString().ToUpper() == "SM" || Session["LoginUserRole"].ToString().ToUpper() == "RBD" || Session["LoginUserRole"].ToString().ToUpper() == "HEMOPHILIA MEDICAL" || Session["LoginUserRole"].ToString().ToUpper() == "GROWTH HORMONE MEDICAL" || (Session["LoginUserRole"].ToString() == "CME Operation" && Model.IsBTC == true)) && ((Model.IssuedBy != Model.Login_User_id)))
                {
                    if (Model.Runrate == 100)
                    {
                        <label style="color:forestgreen;font-size:17px; padding-left: 350px;">Policy violation runrate is @Model.Runrate%</label>
                    }
                    else if (Model.Runrate < 100 && Model.Runrate >= 95)
                    {
                        <label style="color:blue;font-size:17px; padding-left: 350px;">Policy violation runrate is @Model.Runrate%</label>
                    }
                    else
                    {
                        <label style="color: red;font-size:17px; padding-left: 350px;">Policy violation runrate is @Model.Runrate%</label>
                    }
                }
                <div>
                    <label id="ApprovalRestriction" style="color: red;position: relative; left: 100px;"><span>@TempData["ApprovalRestriction"]</span></label>
                </div>
                <fieldset class="form-columns-2">
                    <div class="user-details" style="padding-left: 270px;">
                        @if (Model.RequestType.ToLower() == "closed" || Model.RequestType.ToLower() == "payment requested" || Model.RequestType == "Approved by CME Operation" || (Model.RequestType.ToLower() == "approved by rbd" && Model.IsBTC == false))
                        {
                            if (Model.RequestType.ToLower() == "closed" || Model.RequestType.ToLower() == "payment requested")
                            {<label style="color:red;font-size:17px;"> Form is closed on <span style="color:red;font-size:17px;padding-right:10px">@Html.DisplayFor(model => model.ModifiedDate)</span> </label>
                        }
                        if (Model.IsDownloadSapFile == true)
                        {
                            <label style="color:red;font-size:17px;">
                                Payment Made - @if (Model.IsDownloadSapFile == true)
                                {<span style="color:red;font-size:17px;">Yes</span>}
                                else
                                { <span style="color:red;font-size:17px;">No</span>}
                            </label>
                        }
                        else
                        { <label style="color:red;font-size:17px ;padding-left: 90px;">
                                Payment Made - <span style="color:red;font-size:17px;">No</span>
                            </label>
                        }
                    }
                    </div>
                </fieldset>
                <br />
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        <label>Issued By<br /> <span class="Details-span">@Html.DisplayFor(model => model.Issued_By_Initial)</span></label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>Issued Date<br /> <span class="Details-span">@Html.DisplayFor(model => model.IssuedDate)</span></label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>Form ID<br /><span class="Details-span">@Session["PAFChar"]@Html.DisplayFor(model => model.Form_ID)</span></label>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        <label>Approver(s)<br /> <span class="Details-span">@Html.DisplayFor(model => model.Approver)</span></label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>
                            Hospital Meeting<br />
                            @if (Model.HospitalMeeting == true)
                            {<span class="Details-span">Yes</span>}
                            else
                            { <span class="Details-span">No</span>}
                        </label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>CME Type<br /><span class="Details-span">@Html.DisplayFor(model => model.CME_Type)</span></label>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        <label>
                            Brand/Event/Lecture<br />
                            @if (Model.CME_Type.ToLower() == "standard meeting")
                            {
                                if (Model.LectureName == "")
                                {
                                    <span class="Details-span">@Html.DisplayFor(model => model.BrandName) / @Html.DisplayFor(model => model.EventName)</span>
                                }
                                else
                                {
                                    <span class="Details-span">@Html.DisplayFor(model => model.BrandName) / @Html.DisplayFor(model => model.EventName) / @Html.DisplayFor(model => model.LectureName) </span>
                                }
                            }
                            else
                            { <span>N/A</span>}
                        </label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>
                            Activity Name<br />
                            @if (Model.CME_Type.ToLower() == "standard meeting")
                            {<span class="Details-span">N/A</span> }
                            else
                            { <span class="Details-span">@Html.DisplayFor(model => model.ActivityName)</span>}
                        </label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>
                            Virtual<br />
                            @if (Model.IsVirtual == true)
                            {<span class="Details-span">Yes</span>}
                            else
                            { <span class="Details-span">No</span>}
                        </label>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        @if (Model.CME_Type.ToLower() == "non-standard meeting" && Model.DiseaseArea_Type != null)
                        {<label>Disease Area<br /> <span class="Details-span">@Html.DisplayFor(model => model.DiseaseArea_Type)</span></label>}
                    else
                    { <label></label>}
                    </div>
                    <div> <label></label></div>
                    <div> <label></label></div>
                </div>
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        <label>Activity Start Date<br /><span class="Details-span">@Html.DisplayFor(m => m.ActivityStartDate)</span> </label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>Activity End Date<br /><span class="Details-span">@Html.DisplayFor(m => m.ActivityEndDate)</span> </label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>Number of Days<br /> <span class="Details-span">@Html.DisplayFor(m => m.NumberofDays)</span></label>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        <label>Proposed number of attendee(s)<br /><span class="Details-span">@Html.DisplayFor(m => m.Proposednumberofattendee)</span></label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>Minimum number of guarantee<br /><span class="Details-span">@Html.DisplayFor(m => m.Minimumnumberofgaurantee)</span></label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>City<br /> <span class="Details-span">@Html.DisplayFor(m => m.CityName)</span></label>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        <label>Venue/Hotel<br /> <span class="Details-span">@Html.DisplayFor(m => m.Venu_Hotel)</span></label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>
                            5 Star Hotel?<br />
                            @if (Model.Hotel_Star == true)
                            {<span class="Details-span">Yes</span>}
                            else
                            { <span class="Details-span">No</span>}
                        </label>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        <label>Meeting type<br /> <span class="Details-span">@Html.DisplayFor(m => m.MeetingTypeName)</span></label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>
                            BTC Status<br />
                            @if (Model.IsBTC == true)
                            {<span class="Details-span">Yes</span>}
                            else
                            { <span class="Details-span">No</span>}
                        </label>
                    </div>
                    <div class="col-md-4 mb-2">
                        <label>
                            Work Unit<br />
                            @if (Model.WorkUnitName == null)
                            {<span class="Details-span">N/A</span>}
                            else
                            { <span class="Details-span">@Html.DisplayFor(m => m.WorkUnitName)</span>}
                        </label>
                    </div>
                </div>
                <div class="row align-items-center">
                    <div class="col-md-4 mb-2">
                        @if ((Model.RequestType == "Approved by CME Operation") || (Model.RequestType == "Approved by RBD" && Model.IsVirtual == true) || (Model.RequestType == "Approved by RBD" && Model.IsBTC == false))
                        {
                            <label>Actual Number of attendees</label><span class="mandatory-field">*</span>
                            @Html.TextBoxFor(m => m.Actual_Attendees, new { @class = "form-control ActualAttendees", @type = "number", name = "Actual_Attendees" })
                            @Html.ValidationMessageFor(x => x.Actual_Attendees)
                            <span class="text-danger">@TempData["eActualAttendees"]</span>
                        }
                        else
                        {
                            <label>
                                Actual Number of attendees<br />
                                @if (Model.Actual_Attendees == null)
                                {
                                    <span class="Details-span">N/A</span>
                                }
                                else
                                {
                                    <span class="Details-span">@Html.DisplayFor(m => m.Actual_Attendees)</span>
                                }
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div id="Nav2" class="container tab-pane fade">


                @if (Model.HCPs.Count > 0)
                {

                    <h6 style="text-align:left;">HCP List</h6>

                    <table id="dtBasicExample" class="table table-striped table-bordered table-sm table-style" cellspacing="0" width="100%">
                        <tr>
                            <th>Name</th>
                            <th>Address</th>
                            <th>PAN</th>
                            <th>Topic</th>
                            <th>Cost</th>
                            <th></th>
                        </tr>
                        @foreach (var item in Model.HCPs)
                        {
                            var fileupload1 = "file_" + Convert.ToString(item.Id);
                            var lablel = "Invoice of " + Convert.ToString(item.Name);
                            @Html.HiddenFor(modelItem => item.Id, new { id = "hdn1" })
                            <tr>
                                <td><b>@Html.DisplayFor(modelItem => item.Name)</b></td>
                                @if (item.HCPAddress != null)
                                {
                                    <td id="Hcpaddress" class="hcp-cost-to-add">@Html.DisplayFor(modelItem => item.HCPAddress)</td>
                                }
                                else
                                {
                                    <td></td>
                                }
                                @if (item.PAN != "0000000000")
                                {
                                    <td>@Html.DisplayFor(modelItem => item.PAN)</td>
                                }
                                else
                                {
                                    <td></td>
                                }
                                <td>@Html.DisplayFor(modelItem => item.HCPtopic)</td>
                                @if (item.Cost != 0)
                                {
                                    <td style="text-align:rigIspostponedht;">@Html.DisplayFor(modelItem => item.Cost)</td>
                                }
                                else
                                {
                                    <td></td>
                                }
                                <td></td>

                            </tr>
                            if ((Model.RequestType == "Approved by CME Operation") || (Model.RequestType == "Resend by CT") || (Model.RequestType == "Approved by RBD" && Model.IsVirtual == true) || (Model.RequestType == "Approved by RBD" && Model.IsBTC == false))
                            {
                                if (item.Is_Honorarium == false)
                                {
                                    if (item.Invoice_No == " ")
                                    {
                                        <tr>
                                            <td><label><b>Invoice No:</b></label><br /><span>@Html.DisplayFor(modelItem => item.Invoice_No)</span></td>

                                            <td><label><b>Invoice Date:</b></label><br /></td>

                                            <td><label><b>Net Amount:</b></label><br /><span>@Html.DisplayFor(modelItem => item.Net_Amount)</span></td>

                                            <td><label><b>Tax Amount:</b></label><br /><span>@Html.DisplayFor(modelItem => item.Tax_Amount)</span></td>

                                            <td><label><b>Total Amount:</b></label><br /><span>@Html.DisplayFor(modelItem => item.Total_Amount)</span></td>

                                        </tr>
                                    }
                                }
                                else if (item.Invoice_No != null)
                                {
                                    <tr>
                                        <td><label><b>Invoice No:</b></label><br /><span>@Html.DisplayFor(modelItem => item.Invoice_No)</span></td>

                                        <td><label><b>Invoice Date:</b></label><br /><span>@Html.DisplayFor(modelItem => item.Invoice_Date)</span></td>

                                        <td><label><b>Net Amount:</b></label><br /><span>@Html.DisplayFor(modelItem => item.Net_Amount)</span></td>

                                        <td><label><b>Tax Amount:</b></label><br /><span>@Html.DisplayFor(modelItem => item.Tax_Amount)</span></td>

                                        <td><label><b>Total Amount:</b></label><br /><span>@Html.DisplayFor(modelItem => item.Total_Amount)</span></td>

                                    </tr>
                                }
                                else
                                {
                                    <tr>

                                        @Html.HiddenFor(modelItem => item.Id, new { id = "hcpid" })
                                        @Html.HiddenFor(modelItem => item.Cost, new { id = "hcpcost" })
                                        @Html.HiddenFor(m => m.IHCPId)
                                        @Html.HiddenFor(m => m.IHCPCost)

                                        @if (item.Is_Honorarium == false)
                                        {
                                            <td>
                                                <div class="form-group">
                                                    <label>Invoice No</label>
                                                    @Html.TextBoxFor(m => m.Invoice_No, new { @class = "form-control InvoiceNo", name = "Invoice_No", @Readonly = "true" })
                                                </div>
                                            </td>
                                        }
                                        else if (Model.MeetingTypeName.ToLower() == "virtual" && (item.GST == false || item.GST == null))
                                        {
                                            var Invoiceno = "NN/NGST" + Convert.ToString(Model.Form_ID);
                                            <td>
                                                <label>Invoice No</label><br>
                                                <span><b>@Invoiceno</b></span>
                                            </td>
                                        }
                                        else if (item.GST == false || item.GST == null || item.GST == true)
                                        {
                                            <td>
                                                <div class="form-group">
                                                    <label>Invoice No</label><span class="mandatory-field">*</span>
                                                    @Html.TextBoxFor(m => m.Invoice_No, new { @class = "form-control InvoiceNo", name = "Invoice_No" })
                                                    @Html.ValidationMessageFor(x => x.Invoice_No)
                                                    <span class="text-danger">@TempData["HCPInvoice"]</span>
                                                    <span class="text-danger">@TempData["ValidationForHCPInvoice"]</span>
                                                </div>
                                            </td>
                                        }


                                        @if (item.Is_Honorarium == false)
                                        {
                                            <td>
                                                <div class="form-group">
                                                    <label>Invoice Date </label>
                                                    @Html.TextBoxFor(m => m.Invoice_Date, new { @class = "form-control date-field InvoiceDate", name = "Invoice_Date", @value = "", @Readonly = "true" })
                                                </div>
                                            </td>
                                        }
                                        else if (item.GST == false || item.GST == null || item.GST == true)
                                        {
                                            <td>
                                                <div class="form-group">
                                                    <label>Invoice Date </label><span class="mandatory-field">*</span>
                                                    @Html.TextBoxFor(m => m.Invoice_Date, new { @class = "form-control date-field InvoiceDate", name = "Invoice_Date", id = "changeStartDate", @value = "", @Readonly = "true" })
                                                    @Html.ValidationMessageFor(x => x.Invoice_Date)
                                                    <span class="text-danger">@TempData["HCPIDate"]</span>
                                                </div>
                                            </td>
                                        }

                                        @if (item.GST == true)
                                        {
                                            <td>
                                                <div class="form-group">
