    function SubmitApprove() {

        if ($('form').valid()) {
            if (confirm("Are you sure you want send the form for approval?")) {
                return true;
            } else {
                return false;
            }
        }
    }

    function SubmitReject() {
        if ($('form').valid()) {
            if (confirm("Are you sure you want send the form for Rejection?")) {
                return true;
            } else {
                return false;
            }
        }
    }

    function SubmitPostpone() {
        if (confirm("Are you sure you want send the form for Postpone?"))
            {
                true;
            } else {
              return  false;
            }
        if (true) {
            var comments = $("#Rcomment").val();
            if (comments == "") {
                nameError = "* Please enter comment";
                $('.nav-tabs li:eq(3) a').tab('show');
                $('#eDRcomment').text(' ');
                document.getElementById("name_error").innerHTML = nameError;
                document.getElementById("Rcomment").focus();
                mandatoryerror = "*"
                document.getElementById("mandatory_error").innerHTML = mandatoryerror;
                return false;
            }
            else {
                var id1 = '@Model.Form_ID'
                var id = parseInt(id1)
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("Postpone")',
                    data: { id: id, Comment: comments },
                    dataType: 'json',
                    success: function (result) {
                        if (result == 1) {

                            window.location.href = "/Home/Index";
                        }
                        else {
                            window.location.href = "/CMENew/Details/" + id;
                        }
                    }
                });
            }
        }
    }

