@model CME.Models.HCPView

@{
    ViewBag.Title = "HCP Detail";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<h2 class="section-ttl" style="padding-top:20px;">HCP Detail</h2>

<div class="contentcolor">
    @using (Html.BeginForm("Create", "HCPList", FormMethod.Get, new { role = "form" }))
    {
        <div class="row align-items-center">
            <div class="col-md-6 mb-2">
                <div class="form-controls position-relative">
                    <label> Find by name</label>
                    <input id="searchString" class="search-field" name="searchString" type="text" value="@ViewBag.SearchString" />
                </div>
            </div>
            <div class="col-md-6 mb-2">
                <div class="form-controls position-relative">
                    <label>Find by Coupa Number</label>
                    <input id="searchStringCN" class="search-field" name="CustomerID" type="text" value="@ViewBag.CustomerID" />
                </div>
            </div>
        </div>
        <fieldset class="form-columns-2 col4-label-ht">
            <div class="form-group">
                <input type="submit" class="btn add-btn" value="Search" />&nbsp; &nbsp;
                <button type="submit" class="btn add-btn" formaction=@Url.Action("Reset") formmethod="post">Reset</button>
            </div>
        </fieldset>

        if (Model.SearchNameList != null)
        {
            <div>
                <table id="dtBasicExample" class="table table-striped table-bordered table-sm table-style" cellspacing="0" width="100" style=" width:300px;">
                    <tr>
                        <th style="visibility:hidden">
                            ID
                        </th>

                        <th>
                            Name
                        </th>
                    </tr>

                    @foreach (var item in Model.SearchNameList)
                    {
                        <tr>
                            <td style="visibility:hidden">
                                @Html.DisplayFor(modelItem => item.ID)
                            </td>

                            <td>
                                <a href="@Url.Action("Create", "HCPList", new { CustomerID = item.ID })">@Html.DisplayFor(modelItem => item.FirstName, item.LastName)</a>
                            </td>
                        </tr>
                    }
                </table>

            </div>
        }
    }
</div>

@using (Html.BeginForm("Create", "HCPList", FormMethod.Post, new { role = "form" }))
{
    <div style="padding-top:15px;">
        <div class="contentcolor">

            @Html.HiddenFor(m => m.Id)
            <div class="row align-items-center">
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Vendor Number <span class="mandatory-field">*</span></label>
                        @Html.TextBoxFor(m => m.VendorNo, new { @class = "form-control", maxlength = 10 })
                        @Html.ValidationMessageFor(model => model.VendorNo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Coupa Number <span class="mandatory-field">*</span></label>
                        @Html.TextBoxFor(m => m.CMSNo, new { @class = "form-control", maxlength = 15, @type = "number" })
                        @Html.ValidationMessageFor(model => model.CMSNo, "", new { @class = "text-danger" })
                        <span class="text-danger">@TempData["hcpCMENo"]</span>
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>TMF Number <span class="mandatory-field">*</span></label>
                        @Html.TextBoxFor(m => m.TMFNo, new { @class = "form-control", maxlength = 10 })
                        @Html.ValidationMessageFor(model => model.TMFNo, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row align-items-center">
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>First Name <span class="mandatory-field">*</span></label>
                        @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", maxlength = 50, @id = "Hcpfname" })
                        @Html.ValidationMessageFor(model => model.FirstName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Last Name <span class="mandatory-field">*</span></label>
                        @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", maxlength = 50, @id = "Hcplname" })
                        @Html.ValidationMessageFor(model => model.LastName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Address of HCP <span class="mandatory-field">*</span></label>
                        @Html.TextBoxFor(m => m.HCPAddress, new { @class = "form-control", maxlength = 1000 })
                        @Html.ValidationMessageFor(model => model.HCPAddress, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Therapy Area <span class="mandatory-field">*</span></label>
                        @Html.DropDownListFor(model => model.SelectedUnit, Model.TherapyArea, "- Please select a Therapy area -", new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.SelectedUnit, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
            <div class="row align-items-center">
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Email Id </label>
                        @Html.TextBoxFor(m => m.Email_Id, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Email_Id, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Phone Number </label>
                        @Html.TextBoxFor(m => m.Phone_Number, new { @class = "form-control", maxlength = 12 })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>City </label>
                        @Html.TextBoxFor(m => m.City, new { @class = "form-control", maxlength = 30 })
                    </div>
                </div>
            </div>
            <div class="row align-items-center">
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Contract Start Date </label>
                        @Html.EditorFor(model => model.ContractStartDate, new { htmlAttributes = new { @class = "form-control date-field", @tabindex = 19, @readonly = "true", id = "changeStartDate" } })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Contract End Date </label>
                        @Html.EditorFor(model => model.ContractEndDate, new { htmlAttributes = new { @class = "form-control date-field", @tabindex = 20, @readonly = "true", id = "changeEndDate" } })
                    </div>
                </div>
            </div>
            <div class="form-group">
                <button type="submit" class="btn add-btn">Create</button>
                <button type="submit" class="btn add-btn" name="command" value="update">Update</button>
                <input type="button" class="btn add-btn" value="Back to List" onclick="location.href='@Url.Action("Index", "HCPList")'" />

            </div>

        </div>
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-fQybjgWLrvvRgtW6bFlB7jaZrFsaBXjsOMm/tB9LTS58ONXgqbR9W8oWht/amnpF" crossorigin="anonymous"></script>
<script src='@System.Web.Optimization.Scripts.Url("~/bundles/jqueryui")'></script>
<script src='@System.Web.Optimization.Scripts.Url("~/bundles/validatemin")'></script>
<script type="text/javascript">
    function Search() {
        var hcpname = $("#Hcpfname").val();
        var Customer_ID = $("#Customer_ID").val();
        window.location.href = "@Url.Action("Create", "HCPList")?searchString=" + hcpname + "Customer_ID" + Customer_ID;
    }

    $(document).ready(function () {
          $('#changeStartDate').datepicker({
            dateFormat: "dd-mm-yy",
            changeMonth: true,
            changeYear: true,
            yearRange: "-10:+1",
            minDate: 0,
        });
        $('#changeEndDate').datepicker({
            dateFormat: "dd-mm-yy",
            changeMonth: true,
            changeYear: true,
            yearRange: "-10:+1",
            minDate: 0,
        });
        function boxdisable() {

        }
    });

</script>
