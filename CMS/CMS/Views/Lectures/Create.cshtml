@model CME.Models.Lectures

@{
    ViewBag.Title = "Activity Material Detail";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<h2 class="section-ttl" style="padding-top:20px;">Activity Material Detail</h2>

@using (Html.BeginForm("Create", "Lectures", FormMethod.Post, new { role = "form", enctype = "multipart/form-data" }))
{
    <div class="tab-content contentcolor">
        <div class="form-otrcontainer">
            <div class="row align-items-center">
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Therapy Area <span class="mandatory-field">*</span></label>
                        @Html.DropDownListFor(model => model.SelectedTherapyArea, Model.TherapyArea, "- Please select a Therapy Area -", new { @class = "form-control", id = "ddTherapyArea" })
                        @Html.ValidationMessageFor(model => model.SelectedTherapyArea, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Brand <span class="mandatory-field">*</span></label>
                        @Html.DropDownListFor(model => model.SelectedBrand, new SelectList(string.Empty, "Value", "Text"), "- Please select a Brand -", new { @class = "form-control", id = "ddBrand" })
                        @Html.ValidationMessageFor(model => model.SelectedBrand, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Event <span class="mandatory-field">*</span></label>
                        @Html.DropDownListFor(model => model.SelectedEvent, new SelectList(string.Empty, "Value", "Text"), "- Please select a Event -", new { @class = "form-control", id = "ddEvent" })
                        @Html.ValidationMessageFor(model => model.SelectedEvent, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Package Type <span class="mandatory-field">*</span></label>
                        @Html.DropDownListFor(model => model.SelectedPackageType, Model.PackageType, "- Please select a PackageType -", new { @class = "form-control", id = "ddPackageType" })
                        @Html.ValidationMessageFor(model => model.SelectedPackageType, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-HCPcontrols position-relative">
                        <label>Lecture <span class="mandatory-field">*</span></label>
                        @Html.TextBoxFor(m => m.Lecture, new { @class = "form-control", maxlength = 250, placeholder = "Name" })
                        @Html.ValidationMessageFor(model => model.Lecture, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    @Html.LabelFor(model => model.Status)<span class="mandatory-field">*</span>
                    @Html.CheckBoxFor(model => model.Status, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        @Html.LabelFor(model => model.ImagePath)<span class="mandatory-field" style=" position: relative;  top: 13px; left: -9px;">*</span>
                        <div class="Auploads">
                            @Html.TextBoxFor(m => m.ImageFile, new { type = "file", id = "file6", multiple = "multiple", onchange = "javascript:updateListLM()" })
                            <label for="file6" class="m-0 fileupload-img" style="width: 95%; height: 34px;border-radius: 8px;">File</label>
                            @Html.ValidationMessageFor(m => m.ImageFile)
                        </div>
                        <span class="nameresume"></span>
                        <span class="text-danger" id="file6size"></span>
                    </div>
                </div>
                <div class="col-md-6 mb-2" style="position: relative; left: 18px; top: 15px;">
                    <button type="submit" class="btn add-btn" id="CreateLM">Create</button>
                    <input type="button" class="btn add-btn" value="Back to List" onclick="location.href='@Url.Action("Index", "Lectures")'" />
                </div>
            </div>
        </div>
    </div>
}

<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddTherapyArea").change(function () {
            $("#ddBrand").empty();  
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetBrandByTAId")',
                dataType: 'json',
                data: { id: $("#ddTherapyArea").val() },
                success: function (brands) {
                    $("#ddBrand").append('<option value="">- Please select a Brand -</option>'); 
                    $.each(brands, function (i, brand) {
                        $("#ddBrand").append('<option value="' + brand.Value + '">' + brand.Text + '</option>');
                    });
                },
                error: function (ex) {
                    alert('Failed to retrieve brands: ' + ex);
                }
            });
            return false;
        });

        $("#ddBrand").change(function () {
            populateEventsByBrandId(); 
        });

        function populateEventsByBrandId() {
            $("#ddEvent").empty(); 

            var brandId = $("#ddBrand").val();  
            if (brandId === "") {
                return;
            }

            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetEventsByBrandId")',
                dataType: 'json',
                data: { id: brandId },  
                success: function (events) {
                    $("#ddEvent").append('<option value="">- Please select an Event -</option>');
                    $.each(events, function (i, event) {
                        $("#ddEvent").append('<option value="' + event.Value + '">' + event.Text + '</option>');
                    });
                },
                error: function (ex) {
                    alert('Failed to retrieve events: ' + ex);
                }
            });
        }

        if ($("#ddBrand").val() !== "") {
            populateEventsByBrandId();  
        }

    });
    var maxFileSize = 104857600;
    $('#file6').change(function () {
        $('#file6size').text('');
        var input = document.getElementById('file6');
        for (var i = 0; i < input.files.length; ++i) {
            if ($('#file6')[0].files[i].size != 0) {
                if ($('#file6')[0].files[i].size > maxFileSize) {
                    $('#file6size').text('File too big ! Select file less than 100 MB');
                    $("#CreateLM").attr("disabled", true);
                }
                else { $('#CreateLM').attr("disabled", false); }
            }
            else { $('#file6size').text('File is invalid ! Please upload valid file.'); }
        }
    });

</script>
