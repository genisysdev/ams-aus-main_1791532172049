<script type="text/javascript">
    $(document).ready(function () {
        $("#spanClosed").text(@Session["closedformcount"]);
        $("#spanDraft").text(@Session["Draftformcount"]);
        $("#spanInprocess").text(@Session["Inprocessformcount"]);
        $("#spanRejected").text(@Session["Rejectedformcount"]);
        $("#spanAttend").text(@Session["Attendformcount"]);
        $("#spanApproved").text(@Session["Approvedformcount"]);
        $("#spanRemoved").text(@Session["removedformcount"]);
        $('input[type=datetime]').datepicker({
            dateFormat: "dd-mm-yy",
            changeMonth: true,
            changeYear: true,
            yearRange: "-10:+1"
        });
        $('#home-div input').val('');

    });
</script>