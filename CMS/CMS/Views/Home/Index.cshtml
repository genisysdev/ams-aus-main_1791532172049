    <div class="tab-content contentcolor">
        @if (Session["LoginUserRole"].ToString().ToUpper() == "SR" || Session["LoginUserRole"].ToString().ToUpper() == "CT" || Session["LoginUserRole"].ToString().ToUpper() == "SM" || Session["LoginUserRole"].ToString().ToUpper() == "KAM" || Session["LoginUserRole"].ToString().ToUpper() == "CTB")
