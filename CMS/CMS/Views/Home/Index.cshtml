            }
            @if (Session["LoginUserRole"].ToString().ToUpper() == "SM" || Session["LoginUserRole"].ToString().ToUpper() == "RBD" || Session["LoginUserRole"].ToString() == "CME Operation" || Session["LoginUserRole"].ToString().ToUpper() == "RBD1" || Session["LoginUserRole"].ToString().ToUpper() == "RBD2" || Session["LoginUserRole"].ToString().ToUpper() == "HEMOPHILIA MEDICAL" || Session["LoginUserRole"].ToString().ToUpper() == "GROWTH HORMONE MEDICAL" || Session["LoginUserRole"].ToString().ToUpper() == "CTB")
            {
                <li class="nav-item @((Session["LoginUserRole"].ToString().ToUpper() == "RBD" || Session["LoginUserRole"].ToString() == "CME Operation" || Session["LoginUserRole"].ToString().ToUpper() == "RBD1" || Session["LoginUserRole"].ToString().ToUpper() == "RBD2" || Session["LoginUserRole"].ToString().ToUpper() == "HEMOPHILIA MEDICAL" || Session["LoginUserRole"].ToString().ToUpper() == "GROWTH HORMONE MEDICAL") ? "active" : "")">
                    <a class="nav-link" data-toggle="tab" href="#_SecondTab">Pending Forms</a>
