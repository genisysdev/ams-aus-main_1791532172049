@model PagedList.IPagedList<DataAccessLayer.DAL.Model.PAFList>
@using PagedList.Mvc;

<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

<h6 class="section-ttl">Form Status</h6>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"
        integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"
        crossorigin="anonymous"></script>
<script src="~/Scripts/jquery-1.12.4.js"></script>
<script src="~/Scripts/jquery-1.12.4.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-fQybjgWLrvvRgtW6bFlB7jaZrFsaBXjsOMm/tB9LTS58ONXgqbR9W8oWht/amnpF" crossorigin="anonymous"></script>
<script src='@System.Web.Optimization.Scripts.Url("~/bundles/jqueryui")'></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#draft").tooltip();
        $("#draftdd").tooltip();
        $("#draftdda").tooltip();
        $("#sbyrm").tooltip();
        $("#abyrm").tooltip();
        $("#sbyrbd").tooltip();
        $("#ddsbyrm").tooltip();
        $("#ddabyrm").tooltip();
        $("#ddsbyrbd").tooltip();
        $("#approvedbyrbd").tooltip();
        $("#approvedbysct").tooltip();
        $("#approvedbysctblue").tooltip();
        $("#rejectbyrm").tooltip();
        $("#rejectbyrbd").tooltip();
        $("#rejectbysct").tooltip();
        $("#rejectbyct").tooltip();
        $("#ddrejectbyrm").tooltip();
        $("#ddrejectbyrbd").tooltip();
        $("#ddrejectbysct").tooltip();
        $("#ddrejectbyct").tooltip();
        $("#datedeviation").tooltip();
        $("#closed").tooltip();
        $("#deleted").tooltip();
        $("#ddasbyrm").tooltip();
        $("#ddaabyrm").tooltip();
        $("#ddasbyrbd").tooltip();
        $("#ddarejectbyrm").tooltip();
        $("#ddarejectbyrbd").tooltip();
        $("#ddarejectbysct").tooltip();
        $("#ddarejectbyct").tooltip();
        $("#approvedbyrbd1").tooltip();
        $("#approvedbyrbd1p").tooltip();
        $("#approvedbyrbd2").tooltip();
        $("#approvedbyhm").tooltip();
        $("#approvedbyghm").tooltip();
        $("#ddrejectbyrbd1").tooltip();
        $("#ddrejectbyrbd2").tooltip();
        $("#ddrejectbyhm").tooltip();
        $("#ddrejectbyghm").tooltip();
        $("#approvedbyctb").tooltip();
        $("#rejectedbyctb").tooltip();
        $("#Paymentrequested").tooltip();
        $("#Paymentinitiated").tooltip();
        $("#Sendtocancelapprove").tooltip();
        $("#Sendtopostponeapprove").tooltip();
        $("#postpone").tooltip();
        $("#resend").tooltip();

        var Zone_Name = '@Session["LoginUserZone"]';
        if (Zone_Name == "Rare Disease") {
            $('#details_table td:nth-child(' + 11 + ')').hide();
            $('#details_table th:nth-child(' + 11 + ')').hide();
        }
    });
</script>

@if (Model.Count == 0)
{
    <br />
    <h4>No Records Found</h4>
}
else
{
    <div>
        <table id="dtBasicExample" class="table table-striped table-bordered table-sm table-style" cellspacing="0" width="100%">
            <tr>
                <th />
                <th>
                    @Html.ActionLink("Id", "Index", new { sortOrder = ViewBag.SortById })
                </th>
                <th>
                    @Html.ActionLink("Issued By", "Index", new { sortOrder = ViewBag.SortByIssued })
                </th>
                <th>
                    @Html.ActionLink("Start Date", "Index", new { sortOrder = ViewBag.SortByStartDate })
                </th>
                <th>
                    @Html.ActionLink("End Date", "Index", new { sortOrder = ViewBag.SortByEndDate })
                </th>
                <th>
                    @Html.ActionLink("Request", "Index", new { sortOrder = ViewBag.SortByRequest })
                </th>
                <th>
                    @Html.ActionLink("Activity Name", "Index", new { sortOrder = ViewBag.SortByActivityName })
                </th>
                <th>
                    @Html.ActionLink("Cost Centre", "Index", new { sortOrder = ViewBag.SortByCC })
                </th>
                <th>
                    @Html.ActionLink("Estimated Cost(INR)", "Index", new { sortOrder = ViewBag.SortByCost })
                </th>
                <th>
                    @Html.ActionLink("PAF Status", "Index", new { sortOrder = ViewBag.SortByStatus })
                </th>
                <th>
                    @Html.ActionLink("Is BTC", "Index")
                </th>
                <th>
                    Action
                </th>
            </tr>

            @foreach (var item in Model)
            {
                string[] approve = item.Approver.Split('/');
                <tr>
                    <td />
                    <td>@Html.DisplayFor(modelItem => item.Id)</td>
                    <td>@Html.DisplayFor(modelItem => item.IssuedBy)</td>
                    <td>@Html.DisplayFor(modelItem => item.ViewStartDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.ViewEndDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.CMEType)</td>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Cost_Center)</td>
                    <td>@Html.DisplayFor(modelItem => item.TotalCost)</td>
                    <td>
                        @if (item.SAPFileGenerated.ToLower() == "yes")
                        {
                            <span class="closed" id="closed" title="Report generated"></span>
                        }
                        else
                        {
                            switch (item.Approved_Or_Reject)
                            {
                                case "Draft":
                                    <span class="waitingforapproval" id="draft" title="Save Form"></span>
                                    break;
                                case "Send":
                                    <span class="waitingforapproval" id="sbyrm" title="Pending-@item.ManagerInitial form approval"></span>
                                    break;
                                case "Approved by SM":
                                    <span class="waitingforapproval" id="abyrm" title="Form approved by @item.ManagerInitial, Pending @approve[1] approval"></span>
                                    break;
                                case "Send to RBD":
                                    if (item.ManagerRole.ToUpper() == "RBD")
                                    {
                                        <span class="waitingforapproval" id="sbyrbd" title="Pending @approve[0] form approval"></span>
                                    }
                                    else if (item.IssuerRole == "SM")
                                    {
                                        <span class="waitingforapproval" id="sbyrbd" title="Pending @approve[0] form approval"></span>
                                    }
                                    else
                                    {
                                        <span class="waitingforapproval" id="sbyrbd" title="Pending @approve[1] form approval"></span>
                                    }
                                    break;

                                case "Approved by RBD":
                                    if (item.IsVirtual == true)
                                    {
                                        <span class="status" id="approvedbyrbd" title="Approved"></span>
                                    }
                                    else if (item.IsBTC == false)
                                    {
                                        <span class="status" id="approvedbyrbd" title="Approved"></span>
                                    }
                                    else
                                    {
                                        <span class="waitingforapproval" id="approvedbyrbd" title="Pending-CME Operation approval"></span>
                                    }
                                    break;
                                case "Approved by CME Operation":
                                    <span class="status" id="approvedbysct" title="Approved"></span>
                                    break;
                                case "Reject by SM":
                                    <span class="reject" id="rejectbyrm" title="Rejected by SM"></span>
                                    break;
                                case "Reject by RBD":
                                    <span class="reject" id="rejectbyrbd" title="Rejected by RBD"></span>
                                    break;

                                case "Reject by CME Operation":
                                    <span class="reject" id="rejectbysct" title="Reject by CME Operation"></span>
                                    break;
                                case "Reject by CT":
                                    <span class="reject" id="rejectbyct" title="Form Rejected"></span>
                                    break;
                                case "Closed":
                                    <span class="closed" id="closed" title="Closed"></span>
                                    break;
                                case "Payment requested":
                                    <span class="closed" id="Paymentrequested" title="Payment Requested"></span>
                                    break;
                                case "Payment initiated":
                                    <span class="Paymentinitiated" id="Paymentinitiated" title="Payment Initiated"></span>
                                    break;
                                case "Delete":
                                    <span class="deleted" id="deleted" title="Canceled"></span>
                                    break;
                                case "Send to cancel approve":
                                    <span class="cancelandpostponeapprove" id="Sendtocancelapprove" title="Form Canceled, Pending-@item.ManagerInitial cancel approval"></span>
                                    break;
                                case "Send to postpone":
                                    <span class="cancelandpostponeapprove" id="postpone" title="Form Postponed"></span>
                                    break;
                                case "Resend by CT":
                                    <span class="waitingforapproval" id="resend" title="Form Resend by CT"></span>
                                    break;

                            }
                        }
                    </td>
                    <td>
                        @switch (item.IsBTC)
                        {
                            case true:
                                <span style="background-color: #0000FF;width: 14px;height: 14px;display: block;margin: 0 auto;border-radius: 50px;" id="approvedbysctblue" title="BTC Selected"></span>
                                break;
                            case false:
                                <span style="background-color: #0aac4a;width: 14px;height: 14px;display: block;margin: 0 auto;border-radius: 50px;" id="approvedbysctblue" title="BTC not Selected"></span>
                                break;
                            case null:
                                <span style="background-color: #808080;width: 14px;height: 14px;display: block;margin: 0 auto;border-radius: 50px;"></span>
                                break;
                        }
                    </td>
                    <td class="user-action">
                        <a href="@Url.Action("Status", "CMENew", new { id = item.Id })" onclick="return Submit();">
                            Detail
                        </a>
                    </td>
                </tr>
            }
        </table>

    </div>
    <br />
    <div id='Paging' class="paging">
        <p>Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</p>
        <div class="pagination-container">@Html.PagedListPager(Model, page => Url.Action("Index", new { searchString = ViewBag.SearchString, sortOrder = ViewBag.SortOrder, page }))</div>
    </div>
}
