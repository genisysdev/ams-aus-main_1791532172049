@model PagedList.IPagedList<DataAccessLayer.DAL.Model.PAFList>
@using PagedList.Mvc;

<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

@if (Model.Count == 0)
{
    <br />
    <h4>No Records Found</h4>
}
else
{
    <div>
        <table id="dtBasicExample" class="table table-striped table-bordered table-sm table-style" cellspacing="0" width="100%">
            <tr>
                <th />
                <th>
                    @Html.ActionLink("Id", "Index", new { sortOrder = ViewBag.SortById })
                </th>
                <th>
                    @Html.ActionLink("Issued By", "Index", new { sortOrder = ViewBag.SortByIssued })
                </th>
                <th>
                    @Html.ActionLink("Start Date", "Index", new { sortOrder = ViewBag.SortByStartDate })
                </th>
                <th>
                    @Html.ActionLink("End Date", "Index", new { sortOrder = ViewBag.SortByEndDate })
                </th>
                <th>
                    @Html.ActionLink("Request", "Index", new { sortOrder = ViewBag.SortByRequest })
                </th>
                <th>
                    @Html.ActionLink("Activity Name", "Index", new { sortOrder = ViewBag.SortByActivityName })
                </th>
                <th>
                    @Html.ActionLink("Cost Centre", "Index", new { sortOrder = ViewBag.SortByCC })
                </th>
                <th>
                    @Html.ActionLink("Estimated Cost(INR)", "Index", new { sortOrder = ViewBag.SortByCost })
                </th>
                <th>
                    Status
                </th>
            </tr>

            @foreach (var item in Model)
            {
                <tr>
                    <td />
                    <td>@Html.DisplayFor(modelItem => item.Id)</td>
                    <td>@Html.DisplayFor(modelItem => item.IssuedBy)</td>
                    <td>@Html.DisplayFor(modelItem => item.ViewStartDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.ViewEndDate)</td>
                    <td>@Html.DisplayFor(modelItem => item.CMEType)</td>
                    <td>@Html.DisplayFor(modelItem => item.Name)</td>
                    <td>@Html.DisplayFor(modelItem => item.Cost_Center)</td>
                    <td>@Html.DisplayFor(modelItem => item.TotalCost)</td>

                    @if (item.Approved_Or_Reject.Contains("Reject"))
                    {
                        <td class="user-action">
                            <a href="@Url.Action("Edit", "CMENew", new { id = item.Id })" onclick="return Submit();">
                                Edit
                            </a> <span>|</span>
                            <a href="@Url.Action("Details", "CMENew", new { id = item.Id })" onclick="return Submit();">
                                Detail
                            </a>
                        </td>
                    }
                    else if (item.Approved_Or_Reject == "Draft")
                    {
                        <td class="user-action">
                            <a href="@Url.Action("Edit", "CMENew", new { id = item.Id })" onclick="return Submit();">
                                Edit
                            </a>
                        </td>
                    }
                    else
                    {
                        <td class="user-action">
                            <a href="@Url.Action("Details", "CMENew", new { id = item.Id })" onclick="return Submit();">
                                Detail
                            </a>
                        </td>
                    }
                </tr>
            }
        </table>
    </div>
    <br />
    <div id='Paging' class="paging">
        <p>Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</p>
        <div class="pagination-container">@Html.PagedListPager(Model, page => Url.Action("Index", new { page }))</div>
    </div>
}

