@model DataAccessLayer.DAL.Model.CostCentreMapView

@{
    ViewBag.Title = "Edit CT Cost Center Mapping";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<h2 class="section-ttl" style="padding-top:20px;">Edit User Mapping</h2>
@using (Html.BeginForm("Edit", "CTCostCentre", FormMethod.Post, new { role = "form" }))
{
    <div class="tab-content contentcolor">
        <div class="form-otrcontainer">
            <div class="row align-items-center">
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Cost Center <span class="mandatory-field">*</span></label>
                        @Html.DropDownListFor(m => m.SelectedCostCenter, Model.CostCenter, "- Please select a Cost Center -", new { @class = "form-control", id = "costcentercode" })
                        @Html.ValidationMessageFor(m => m.SelectedCostCenter)
                    </div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="form-controls position-relative">
                        <label>Cost Center Name <span class="mandatory-field">*</span></label>
                        @Html.DropDownListFor(model => model.SelectedCostCenter, Model.CostCenterName, "- Please select a Cost Center -", new { @class = "form-control", id = "CostcenterName" })
                        @Html.ValidationMessageFor(model => model.SelectedCostCenter, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group" style="position: relative; left: 18px; top: 15px;">
                    <button type="submit" class="btn add-btn" name="command" value="Update">Assign User</button>
                    <input type="button" class="btn add-btn" value="Cancel" onclick="location.href='@Url.Action("Index", "CTCostCentre")'" />
                </div>
            </div>
        </div>
    </div>
}

@if (Model.CTCCList.Count == 0)
{
    <br />
    <h4>No Records Found</h4>
}
else
{
    <div class="responsible-table">
        <table class="table">
            <tr>
                <th style="visibility:hidden">
                    Id
                </th>
                <th>
                    User Initials
                </th>
                <th>
                    Cost Center
                </th>
                <th></th>
            </tr>

            @foreach (var item in Model.CTCCList)
            {
                <tr>
                    <td style="visibility:hidden">
                        @Html.DisplayFor(modelItem => item.Id)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.UserInitial)

                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CostCenter_Code)
                    </td>
                    <td class="user-action">
                        <a href="@Url.Action("Deactivate", "CTCostCentre", new { id = item.Id, UserId = item.UserId })" onclick="return Submit();">
                            <img src="~/Content/Images/trash-icon.svg" alt="Delete" />
                        </a>
                    </td>
                </tr>
            }
        </table>

    </div>

    <script type="text/javascript">
        function Submit() {
            if (confirm("Are you sure you want to delete record?")) {
                return true;
            } else {
                return false;
            }
        }

         $(document).ready(function () {
                $("#CostcenterName").change(function () {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("GetCostcenter")',
                        dataType: 'json',
                        data: { id: $("#CostcenterName").val() },
                        success: function (events) {
                            $("#costcentercode").empty();
                            $.each(events, function (i, event) {
                                $("#costcentercode").append('<option value="'
                                    + event.Value + '">'
                                    + event.Text + '</option>');
                            });
                        },
                        error: function (ex) {
                        }
                    });
                    return false;
                });
            });
    </script>
}

<script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
<script src="~/Scripts/jquery-3.4.1.js"></script>
<script src="~/Scripts/jquery-3.4.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-fQybjgWLrvvRgtW6bFlB7jaZrFsaBXjsOMm/tB9LTS58ONXgqbR9W8oWht/amnpF" crossorigin="anonymous"></script>
<script src='@System.Web.Optimization.Scripts.Url("~/bundles/jqueryui")'></script>
<script src='@System.Web.Optimization.Scripts.Url("~/bundles/validatemin")'></script>